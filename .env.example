# Copy to .env and fill in what you have. Missing keys = that source is skipped (never crashes the run).

# Reddit  -> https://www.reddit.com/prefs/apps  (create a "script" app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=netnography-analyzer/0.1 by u/your_username
# Optional: your own Reddit login (only needed for higher limits; never committed)
REDDIT_USERNAME=
REDDIT_PASSWORD=

# Google Places API (New) -> https://console.cloud.google.com  (enable "Places API (New)")
GOOGLE_PLACES_API_KEY=

# YouTube Data API v3 -> same Google Cloud console
YOUTUBE_API_KEY=

# Crunchbase API (paid plan required) -> https://data.crunchbase.com
CRUNCHBASE_API_KEY=

# Optional override of the HTTP user agent
HTTP_USER_AGENT=

# Browser used for Trustpilot / LinkedIn / etc. Default 'chrome' = your installed Google Chrome.
# Options: chrome | msedge | chromium (needs `playwright install chromium`)
BROWSER_CHANNEL=chrome
# Or point to any Chromium-based browser (Brave, Arc, ...):
BROWSER_EXECUTABLE=
